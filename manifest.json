{
  "manifest_version": 3,
  "name": "Runway Helper",
  "version": "1.0.0",
  "description": "Earnings tracking, video controls, and selected-text Google Images search for Runway annotation.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Runway Helper",
    "default_popup": "earnings/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [{
    "matches": ["https://caption-verify-ext.ext.runwayml.com/*"],
    "js": ["video-interactions.js", "earnings/earnings.js", "earnings/tracker.js"],
    "run_at": "document_start",
    "all_frames": false
  }, {
    "matches": ["https://caption-verify-ext.ext.runwayml.com/*"],
    "js": ["image-search/image-search.js", "player-controls.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
