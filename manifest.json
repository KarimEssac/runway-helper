{
  "manifest_version": 3,
  "name": "Runway Helper",
  "version": "0.2.2",
  "description": "Video playback speed and centered alignment guides for Runway video annotation.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Runway Helper",
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [{
    "matches": ["https://caption-verify-ext.ext.runwayml.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
